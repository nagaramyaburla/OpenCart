<?xml version="1.0" encoding="UTF-8"?>

<!--
    Log4j2 Configuration File

    Purpose:
    - Print logs to Eclipse/Console
    - Save logs to a file
    - Use INFO level logging by default
-->

<Configuration status="WARN">

    <!--
        Appenders define WHERE logs should be written.
        Console -> Eclipse/Command Prompt/Jenkins Console
        File    -> Physical log file
    -->
    <Appenders>

        <!--
            Console Appender

            target="SYSTEM_OUT"
            - Sends logs to standard output
            - Similar to System.out.println()
        -->
        <Console name="Console" target="SYSTEM_OUT">

            <!--
                Log Pattern Explanation

                %d{yyyy-MM-dd HH:mm:ss}
                -> Date and Time

                %-5p
                -> Log Level (INFO, ERROR, WARN, DEBUG)
                   aligned to 5 characters

                %c{1}
                -> Class Name only

                [%t]
                -> Thread Name

                -
                -> Separator

                %m
                -> Log Message

                %n
                -> New Line
            -->
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} [%t] - %m%n"/>

        </Console>

        <!--
            File Appender

            fileName="logs/application.log"
            - Creates logs folder automatically
            - Creates application.log file

            append="false"
            - Clears old logs every execution

            append="true"
            - Appends logs to existing file
        -->
        <File
            name="File"
            fileName="logs/application.log"
            append="false">

            <!-- Same log format used in file -->
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} [%t] - %m%n"/>

        </File>

    </Appenders>

    <!--
        Loggers define WHAT gets logged.
    -->
    <Loggers>

        <!--
            Root Logger

            INFO  -> INFO, WARN, ERROR, FATAL
            DEBUG -> DEBUG + INFO + WARN + ERROR + FATAL
            ERROR -> ERROR + FATAL only
        -->
        <Root level="debug">

            <!-- Send logs to console -->
            <AppenderRef ref="Console"/>

            <!-- Send logs to file -->
            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>